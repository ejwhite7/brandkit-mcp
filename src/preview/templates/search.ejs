<h1>Search</h1>
<form method="get" action="/search">
  <input type="text" name="q" value="<%= query %>" placeholder="Search the brand system..." class="search-input">
  <button type="submit" class="search-button">Search</button>
</form>

<% if (query) { %>
<p class="description"><%= results.length %> result(s) for &ldquo;<%= query %>&rdquo;</p>
<% if (results.length > 0) { %>
<table class="data-table">
  <thead><tr><th>Kind</th><th>Snippet</th><th>Context</th><th>Source</th></tr></thead>
  <tbody>
    <% for (const r of results) { %>
    <tr>
      <td><span class="badge"><%= r.kind %></span></td>
      <td><%= r.snippet %></td>
      <td><%= r.context || '' %></td>
      <td><code><%= r.source || '' %></code></td>
    </tr>
    <% } %>
  </tbody>
</table>
<% } %>
<% } %>
