<h1>CSS</h1>
<p class="context-switch">
  <% for (const c of ['base', 'web', 'product']) { %><a href="?context=<%= c %>" class="badge<%= c === ctx ? ' active' : '' %>"><%= c %></a><% } %>
</p>

<h2>colors_and_type.css</h2>
<% if (colorsAndTypeCss) { %>
<pre class="doc-body"><%= colorsAndTypeCss %></pre>
<% } else { %>
<p>Not present.</p>
<% } %>

<h2>motion.css</h2>
<% if (motionCss) { %>
<pre class="doc-body"><%= motionCss %></pre>
<% } else { %>
<p>Not present.</p>
<% } %>
