<h1>Colors</h1>
<p class="context-switch">
  <% for (const c of ['base', 'web', 'product']) { %><a href="?context=<%= c %>" class="badge<%= c === ctx ? ' active' : '' %>"><%= c %></a><% } %>
</p>

<% if (colors.length === 0) { %>
<p>No colors found for the <%= ctx %> context.</p>
<% } else { %>
<div class="color-grid">
  <% for (const c of colors) { %>
  <div class="color-swatch">
    <div class="swatch" style="background: <%= c.hex || c.value %>"></div>
    <div class="color-info">
      <strong><%= c.name %></strong>
      <code><%= c.token %></code>
      <span class="value"><%= c.value %></span>
      <% if (c.role) { %><span class="role"><%= c.role %></span><% } %>
    </div>
  </div>
  <% } %>
</div>
<% } %>
